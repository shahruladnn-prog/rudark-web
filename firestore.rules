rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products, Categories, Reviews: Everyone can read
    match /products/{product} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{category} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{review} {
      allow read: if true;
      allow write: if false;
    }

    // Orders: No direct client access. Handled via Server Actions (Admin SDK).
    match /orders/{order} {
      allow read, write: if false;
    }
    
    // Default: Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
